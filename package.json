    "electron:build": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.181.2",
    "three-mesh-bvh": "^0.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "^0.181.0",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.spiderweb.editor",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
